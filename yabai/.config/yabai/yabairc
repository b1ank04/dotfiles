#!/bin/sh

# Keep yabai only as a fast navigator for native macOS Spaces.
# The scripting addition is intentionally not loaded in this mode.
yabai -m config layout float
yabai -m config skip_window_focus_animation on

# Never tile windows, including windows that already exist when yabai starts.
yabai -m rule --add label="unmanaged-all" app=".*" manage=off
yabai -m rule --apply "unmanaged-all"
